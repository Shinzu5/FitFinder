# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fitfinder

# JWT
JWT_ACCESS_SECRET=fitfinder-access-secret-change-in-production
JWT_REFRESH_SECRET=fitfinder-refresh-secret-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email (Resend API)
RESEND_API_KEY=
RESEND_FROM=

# Password reset
PASSWORD_RESET_EXPIRES_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
