# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Production: comma-separated allowlist, e.g. https://www.fitfinder.fun,https://fitfinder.fun
FRONTEND_URLS=http://localhost:3000

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require

# JWT — generate strong random secrets for production (e.g. openssl rand -base64 32)
JWT_ACCESS_SECRET=replace_with_a_strong_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_strong_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email (Resend API — https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM="FitFinder <noreply@yourdomain.com>"

# Password Reset
PASSWORD_RESET_EXPIRES_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5

# Xendit Payment Gateway (https://dashboard.xendit.co)
XENDIT_SECRET_KEY=xnd_development_your_xendit_secret_key_here
XENDIT_WEBHOOK_TOKEN=your_xendit_webhook_token_here

# AI Assistant (Gemini — https://aistudio.google.com)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1024
